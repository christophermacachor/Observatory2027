{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "observatory2027",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  
  "kv_namespaces": [
    {
      "binding": "NOAA_CACHE",
      "id": "YOUR_KV_ID_HERE"
    }
  ],
  
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1.0
    }
  },
  
  "vars": {
    "NOAA_API_BASE": "https://api.weather.gov",
    "CACHE_DEFAULT_TTL": 300,
    "CACHE_FORECAST_TTL": 900,
    "CACHE_OBSERVATION_TTL": 120,
    "APP_NAME": "Observatory2027",
    "APP_EMAIL": "contact@macachor.org",
    "ENVIRONMENT": "production"
  },
  
  "routes": [
    {
      "pattern": "space.macachor.org/*",
      "custom_domain": true
    }
  ]
}    "NOAA_API_BASE": "https://api.weather.gov",
    "CACHE_DEFAULT_TTL": 300,
    "CACHE_FORECAST_TTL": 900,
    "CACHE_OBSERVATION_TTL": 120,
    "APP_NAME": "Observatory2027",
    "APP_EMAIL": "contact@macachor.org",
    "ENVIRONMENT": "production"
  },
  
  // Routes (if you have custom domains)
  "routes": [
    {
      "pattern": "space.macachor.org/*",
      "custom_domain": true
    }
  ]
}
